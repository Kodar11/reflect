{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "../../dist-electron",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["../../types", "node"],
  "skipLibCheck": true
  },
  "include": [
    "../electron/main.ts",
    "../electron/preload.cts",
    "../electron/util.ts",
    "../electron/pathResolver.ts",
    "../tracker/**/*.ts",
    "../database/**/*.ts",
    "../models/**/*.ts",
    "../session/**/*.ts",
    "../timeline/**/*.ts",
    "../categorization/**/*.ts",
    "../focus/**/*.ts",
    "../profile/**/*.ts",
    "../intelligence/**/*.ts",
    "../learning/**/*.ts",
    "../database/EditRepository.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
